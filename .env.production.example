# Copy to .env.production and fill in. Never commit the real file.
# Also export POSTGRES_PASSWORD in your shell or put it in a .env next to docker-compose.yml.
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=generate-a-long-random-value
ALLOWED_HOSTS=partly.example.com
CSRF_TRUSTED_ORIGINS=https://partly.example.com
SITE_URL=https://partly.example.com

PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_LISTING_FEE_INR=49

DEFAULT_FROM_EMAIL=Partly <hello@partly.example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Raise PWA_CACHE_VERSION when you change the service worker or the precached files.
PWA_CACHE_VERSION=v1

# Shown on the Terms, Privacy and Refund pages and in the footer. Set to the real operator.
LEGAL_ENTITY_NAME=Your Name or Company
SUPPORT_EMAIL=support@partly.example.com
LEGAL_LAST_UPDATED=10 November 2026
# Domain Caddy gets a certificate for (DNS must already point at this server).
DOMAIN=partly.example.com
# Optional error monitoring (https://sentry.io, free tier). Leave empty to turn off.
SENTRY_DSN=
