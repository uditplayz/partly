# Copy to .env and adjust.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/partly
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True
PLATFORM_LISTING_FEE_INR=49
# Payments: "mock" is a sandbox with no real money. Use "razorpay" in production.
PAYMENT_PROVIDER=mock
PAYMENT_ORDER_TTL_MINUTES=30
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
PWA_CACHE_VERSION=v1
